# Ollama (self-hosted local AI model) — replaces the old Gemini API dependency.
# OLLAMA_BASE_URL: where the Ollama server is reachable (local dev: default localhost;
# Railway: the internal address of the Ollama service, e.g. http://ollama.railway.internal:11434).
# OLLAMA_MODEL: the model tag to use, must already be pulled on that Ollama instance.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL / DIRECT_URL: Postgres connection strings (e.g. from Supabase or Railway).
# DATABASE_URL is the pooled connection used by the app; DIRECT_URL is the direct
# connection used for running Prisma migrations.
DATABASE_URL="MY_DATABASE_URL"
DIRECT_URL="MY_DIRECT_URL"

# JWT_SECRET: Random secret used to sign auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="MY_JWT_SECRET"

# Meta / Facebook Messenger webhook (manual test-token connection, see CLAUDE.md).
# META_APP_SECRET verifies incoming webhook signatures (App settings -> Basic).
# META_VERIFY_TOKEN is a random string you choose and paste into the Meta webhook
# config to complete the handshake. META_PAGE_ACCESS_TOKEN is generated per-Page
# in the app's Messenger API Settings.
META_APP_SECRET="MY_META_APP_SECRET"
META_VERIFY_TOKEN="MY_META_VERIFY_TOKEN"
META_PAGE_ID="MY_META_PAGE_ID"
META_PAGE_ACCESS_TOKEN="MY_META_PAGE_ACCESS_TOKEN"

# Facebook OAuth self-serve connect flow (see PLANNING.md Option B).
# FACEBOOK_APP_ID is public (safe to expose), used to build the OAuth dialog URL.
FACEBOOK_APP_ID="MY_FACEBOOK_APP_ID"
# CHANNEL_ENCRYPTION_KEY: 32-byte hex key (64 chars) for AES-256-GCM encryption of
# per-merchant channel tokens stored via the OAuth flow. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHANNEL_ENCRYPTION_KEY="MY_CHANNEL_ENCRYPTION_KEY"
